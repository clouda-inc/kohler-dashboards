{
  "vendor": "eypartnerus",
  "name": "kohler-dashboards",
  "version": "0.0.0",
  "title": "Kohler Dashboards",
  "description": "Kohler Dashboards",
  "builders": {
    "react": "3.x",
    "messages": "1.x",
    "docs": "0.x",
